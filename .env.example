# Copier ce fichier en .env et adapter si besoin.

# URL du serveur Ollama local. Par défaut 11434, MAIS sur certaines machines Windows
# (Hyper-V/WSL2 actifs), ce port est réservé par le système et Ollama ne peut pas s'y lier
# (erreur "bind: An attempt was made to access a socket in a way forbidden by its access
# permissions"). Dans ce cas, démarrer Ollama avec un port alternatif :
#   OLLAMA_HOST=127.0.0.1:12500 ollama serve
# et renseigner la même valeur ci-dessous.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Utilisée uniquement par docker-compose (voir docker-compose.yml) : depuis l'intérieur d'un
# conteneur, l'hôte n'est pas 127.0.0.1 mais host.docker.internal. Même port que ci-dessus.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Port hôte sur lequel l'API du conteneur est publiée (voir docker-compose.yml). 8000 peut être
# réservé par Windows (Hyper-V/WSL2, voir note plus bas) : 8600 est utilisé par défaut.
HOST_PORT=8600

OLLAMA_LLM_MODEL=llama3.1:8b
# Fenêtre de contexte demandée à Ollama (sinon prompt tronqué silencieusement).
OLLAMA_NUM_CTX=8192
# LLM juge pour Ragas, distinct du générateur (ollama pull qwen2.5:7b).
JUDGE_LLM_MODEL=qwen2.5:7b

# Modèle multilingue : corpus en anglais, questions en français.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Mesurés en tokens du tokenizer d'embeddings (max 512 pour multilingual-e5).
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=dbt_airflow_docs

TOP_K=4
RETRIEVAL_CANDIDATES=20
# Reranker cross-encoder multilingue ; laisser vide pour désactiver le reranking.
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Seuil optionnel de refus avant LLM (à calibrer avec run_eval.py --retrieval-only). Vide = désactivé.
RELEVANCE_THRESHOLD=

# Conversation : nombre d'échanges précédents transmis au LLM et à la reformulation des relances.
HISTORY_MAX_TURNS=3
# Compléments (expérimental) : nombre maximal, score minimal du reranker pour qu'une mise en garde
# soit jugée liée à la question, et probabilité d'implication NLI minimale pour l'afficher.
COMPLEMENTS_MAX=3
COMPLEMENTS_MIN_SCORE=0
COMPLEMENTS_MIN_ENTAILMENT=0.5

MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=rag-genai-eval

# Observabilité Langfuse (optionnelle) : une trace par question (recherche, prompt, réponse,
# latence) pour l'API, l'évaluation et la construction des paires DPO. Laisser les clés vides
# pour désactiver. Clés : Langfuse > Settings > API Keys du projet.
# LANGFUSE_BASE_URL : http://localhost:3000 en local (langfuse/, clés données par
# `python langfuse/init_env.py`), ou https://cloud.langfuse.com pour Langfuse Cloud (UE).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Pour l'API dans Docker : le serveur Langfuse local se joint via host.docker.internal.
LANGFUSE_BASE_URL_DOCKER=http://host.docker.internal:3000
# Coupe le traçage sans retirer les clés (par exemple pour un long run DPO).
LANGFUSE_TRACING_ENABLED=true
